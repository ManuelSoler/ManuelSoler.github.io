      },
    ],
  },
  {
    id: 'schools',
    label: 'Activities in schools',
    items: [
      {
        year: '2026',
        title: '“Chemtrails or Contrails? That Is the Question”, talk for vocational training students at IES Julio Verne',
        url: `${lab}/2026/04/20/outreach-activity-at-ies-julio-verne-chemtrails-or-contrails-that-is-the-question/`,
      },
      {
        year: '2025',
        title: 'Water-rocket building and launch workshop at CEIP Teresa Berganza',
      },
      {
        year: '2024',
        title:
          'El impacto de las estelas de condensación de los aviones en el cambio climático, Instituto Gerardo Diego (PEAC Madrid Oeste)',
        url: 'https://www.uc3m.es/ss/Satellite/UC3MInstitucional/es/TextoDosColumnas/1371384734120/',
      },
      {
        year: '2024',
