---
import { bandStyle } from '../lib/band';
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

const awards = [
  {
    year: '2026',
    title: '1st Prize, VI Margarita Salas Awards',
    text: 'Awarded to research of the Aircraft Operations Lab.',
    url: 'https://aircraftoperationslab.com/news/',
  },
  {
    year: '2026',
    title: 'UC3M Excellence Award (2025 edition)',
    text: 'Recognised at the UC3M Excellence Awards, together with Andrea Ianiro.',
    url: 'https://aircraftoperationslab.com/news/',
  },
  {
    year: '2026',
    title: 'Frontiers Planet Prize: National Champion of Spain and international finalist',
    text: 'For Simorgh and Soler (2025). A global competition by the Frontiers Research Foundation that rewards research offering scalable solutions to keep Earth within its safe operating space.',
  },
  {
    year: '2024',
