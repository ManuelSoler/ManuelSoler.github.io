---
import { getCollection } from 'astro:content';

const lines = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<ol class="lines">
  {
    lines.map((line) => (
      <li>
        <a class="line" href={`/research/${line.id}/`}>
          <div class="line__img">
            <img src={line.data.cardImage} alt="" loading="lazy" />
          </div>
          <div class="line__body">
            <span class="line__num">{String(line.data.order).padStart(2, '0')}</span>
            <h3>{line.data.title}</h3>
            <p>{line.data.summary}</p>
            <span class="line__more">Read more</span>
          </div>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .line {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-top: 3px solid var(--blue);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }
  .line:hover {
    border-top-color: var(--gold);
    box-shadow: 0 18px 36px rgba(11, 12, 42, 0.12);
    transform: translateY(-3px);
  }
  .line__img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--soft);
    border-bottom: 1px solid var(--line);
  }
  .line__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .line__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 24px 24px 26px;
  }
  .line__num {
    font-family: var(--title);
    font-size: 1.05rem;
    color: var(--gold);
    letter-spacing: 0.08em;
  }
  .line h3 {
    font-size: 1.5rem;
    margin: 6px 0 12px;
  }
  .line p {
    color: var(--muted);
    font-size: 1rem;
    margin-bottom: 20px;
  }
  .line__more {
    margin-top: auto;
    font-weight: 600;
    color: var(--blue);
  }
  .line__more::after {
    content: ' →';
  }
  @media (max-width: 900px) {
    .lines {
      grid-template-columns: 1fr;
    }
  }
</style>
