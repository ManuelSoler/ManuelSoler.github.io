const videos = [
  { id: 'O2TvoBxFiuk', title: 'El catedrático de la UC3M Manuel Soler, nominado a los Frontiers Planet Prize', by: 'UC3M' },
  {
    id: 'qEvUPQHX8js',
    title: 'IA para ver el impacto en el clima de las estelas de condensación de los aviones',
    by: 'UC3M',
  },
  { id: '8UyAwRYAd3Q', title: 'Trayectorias de aviones climáticamente óptimas', by: 'UC3M' },
  { id: 'dJwvDebPp48', title: 'Teatro y Ciencia en la Noche de los Investigadores', by: 'Manuel Soler UC3M' },
  { id: 'VVNYFahmRsE', title: 'State of the Climate report', by: 'E-CONTRAIL 2 project' },
  { id: 'dm9W9D3TXaI', title: 'E-CONTRAIL project intermediate results', by: 'E-CONTRAIL 2 project' },
  { id: '6fy0144g0SQ', title: 'E-CONTRAIL project', by: 'E-CONTRAIL 2 project' },
  { id: 'PCKcSJW8DkY', title: 'RefMap Interviews: Manuel Soler', by: 'RefMap Project' },
  { id: 'hLHcQmMqlHU', title: 'The KAIROS project', by: 'KAIROS Project' },
  { id: 'MByF2EabQq0', title: 'SESAR Interview Airspace World: FlyATM4E', by: 'ATCNetworkTV' },
  { id: 'FymsNU9Jwws', title: 'ALARM achievements and solutions', by: 'Manuel Soler UC3M' },
  { id: 'WL89LaqaE2o', title: 'Interview START Project: key achievements', by: 'Manuel Soler UC3M' },
  { id: 'R6r2RADRZGU', title: 'Proyecto START', by: 'UC3M' },
  { id: 'fNGTv3Itacc', title: 'Talk at the Met Tech virtual conference', by: 'Manuel Soler UC3M' },
];
---

<Base title="Outreach" description="Outreach activities, popular science, media and videos by Manuel Soler.">
  <section class="pband" style={await bandStyle('contrails', 'center 85%')}>
    <div class="wrap">
      <p class="pband__eyebrow">Outreach</p>
      <h1>Science for everyone</h1>
      <p class="pband__lead">
        Alongside research I run outreach activities, mainly for primary and secondary schools, combining arts and
        science: the European Researchers' Night, Science Week, school visits and science fairs, plus videos for the
        general public.
      </p>
    </div>
  </section>

  <div class="wrap page">
    <section class="block">
      <h2 id="reads">To read</h2>
      <ul class="reads">
        {
          reads.map((r) => (
            <li>
              <a class="reads__cover" href={r.url} tabindex="-1" aria-hidden="true">
                <Image src={r.cover} alt="" width={360} />
              </a>
              <p class="reads__sub">{r.sub}</p>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
              <a class="arrow-link" href={r.url}>
                {r.cta}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="narrow">
      {
        groups.map((g) => (
          <section class="block">
            <h2 id={g.id}>{g.label}</h2>
            <ul class="rows">
              {g.items.map((i) => (
                <li>
                  <span class="rows__label">{i.year}</span>
                  <div class="rows__title">{i.url ? <a href={i.url}>{i.title}</a> : i.title}</div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <section class="block">
      <h2 id="videos">Videos</h2>
      <p class="block__intro">Talks, interviews and project videos. Each one opens on YouTube.</p>
      <ul class="videos">
        {
          videos.map((v) => (
            <li>
              <a href={`https://www.youtube.com/watch?v=${v.id}`}>
                <span class="videos__thumb">
                  <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" loading="lazy" width="320" height="180" />
                </span>
                <span class="videos__title">{v.title}</span>
                <span class="videos__by">{v.by}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .narrow {
    max-width: 900px;
  }
  .narrow .block {
    margin-bottom: clamp(44px, 6vw, 72px);
  }
  .reads {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .reads__cover {
    display: block;
    aspect-ratio: 3 / 4;
    background: var(--soft);
    border: 1px solid var(--line);
    overflow: hidden;
    margin-bottom: 18px;
  }
  .reads__cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .reads__sub {
    margin: 0 0 6px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }
  .reads h3 {
    font-size: 1.4rem;
    margin-bottom: 10px;
  }
  .reads p:not(.reads__sub) {
    color: var(--muted);
    font-size: 1rem;
  }
  .videos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 28px 24px;
  }
  .videos a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .videos__thumb {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--night);
    overflow: hidden;
    margin-bottom: 12px;
  }
  .videos__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s;
  }
  .videos__thumb::after {
    content: '';
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 0;
    height: 0;
    border-left: 16px solid #fff;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.6));
  }
  .videos a:hover img {
    transform: scale(1.04);
  }
  .videos__title {
    display: block;
    font-weight: 500;
    line-height: 1.35;
    color: var(--head);
  }
  .videos a:hover .videos__title {
    color: var(--blue);
  }
  .videos__by {
    display: block;
    margin-top: 4px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .reads {
      grid-template-columns: 1fr;
      max-width: 420px;
    }
  }
</style>
