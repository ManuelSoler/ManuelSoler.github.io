---
import { bandStyle } from '../lib/band';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="pband" style={await bandStyle('wing')}>
    <div class="wrap">
      <p class="pband__eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="pband__lead">
        This site was rebuilt and some old pages and blog posts were retired. The sections below should get you where
        you were going.
      </p>
    </div>
  </section>
  <div class="wrap page">
    <ul class="anchors">
      <li><a href="/">Home</a></li>
      <li><a href="/research/">Research</a></li>
      <li><a href="/publications/">Publications</a></li>
      <li><a href="/projects/">Projects</a></li>
      <li><a href="/book/">Books</a></li>
      <li><a href="/teaching/">Teaching</a></li>
      <li><a href="/outreach/">Outreach</a></li>
    </ul>
  </div>
</Base>
