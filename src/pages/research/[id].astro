---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../lib/site';
import { bandStyle, type BandPhoto } from '../../lib/band';

const bands: Record<string, BandPhoto> = {
  'contrail-observation': 'contrails',
  'contrail-modelling': 'sky',
  'climate-optimized-trajectories': 'wing',
};

export async function getStaticPaths() {
  const lines = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
  return lines.map((line, i) => ({
    params: { id: line.id },
    props: { line, prev: lines[i - 1], next: lines[i + 1] },
  }));
}

const { line, prev, next } = Astro.props;
const { Content, headings } = await render(line);
const sections = headings.filter((h) => h.depth === 2);
const num = String(line.data.order).padStart(2, '0');
---

<Base title={line.data.title} description={line.data.summary}>
  <section class="pband" style={await bandStyle(bands[line.id] ?? 'sky')}>
    <div class="wrap">
      <p class="pband__eyebrow"><a href="/research/">Research</a> · Line {num}</p>
      <h1>{line.data.title}</h1>
      <p class="pband__lead">{line.data.tagline}</p>
    </div>
  </section>

  <div class="wrap layout">
    <aside class="side">
      <nav aria-label="On this page">
        <p class="side__h">On this page</p>
        <ul>
          {
            sections.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))
          }
          {line.data.projects.length > 0 && <li><a href="#related-projects">Related projects</a></li>}
        </ul>
      </nav>
      {
        line.data.people.length > 0 && (
          <div class="side__people">
            <p class="side__h">Working on this</p>
            <ul>
              {line.data.people.map((p) => (
                <li>
                  <strong>{p.name}</strong>
                  <span>{p.role}</span>
                </li>
              ))}
            </ul>
            <a class="arrow-link" href={`${site.labUrl}team/`}>
              Lab team
            </a>
          </div>
        )
      }
    </aside>

    <article class="prose">
      <Content />

      {
        line.data.projects.length > 0 && (
          <>
            <h2 id="related-projects">Related projects</h2>
            <ul class="projects">
              {line.data.projects.map((p) => (
                <li>
                  <h3>{p.url ? <a href={p.url}>{p.name}</a> : p.name}</h3>
                  <p>{p.description}</p>
                  <span>{p.funding}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </article>
  </div>

  <nav class="pager" aria-label="Research lines">
    <div class="wrap pager__in">
      {
        prev ? (
          <a href={`/research/${prev.id}/`}>
            <span>← Previous line</span>
            {prev.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pager__next" href={`/research/${next.id}/`}>
            <span>Next line →</span>
            {next.data.title}
          </a>
        )
      }
    </div>
  </nav>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 760px);
    gap: clamp(32px, 6vw, 88px);
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }
  .side {
    position: sticky;
    top: 108px;
    align-self: start;
    font-size: 0.98rem;
  }
  .side__h {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 12px;
  }
  .side ul {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }
  .side nav li {
    border-left: 2px solid var(--line);
  }
  .side nav a {
    display: block;
    padding: 7px 0 7px 14px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--ink);
    text-decoration: none;
  }
  .side nav a:hover {
    color: var(--blue);
    border-left-color: var(--blue);
  }
  .side__people {
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .side__people li {
    margin-bottom: 14px;
  }
  .side__people strong {
    display: block;
    font-weight: 600;
    color: var(--head);
  }
  .side__people span {
    display: block;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .prose :global(h2) {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin: 2.2em 0 0.7em;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 100px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .prose :global(p) {
    margin-bottom: 1.15em;
  }
  .prose :global(figure) {
    margin: 2em 0;
  }
  .prose :global(figure img) {
    width: 100%;
    border: 1px solid var(--line);
  }
  .prose :global(figcaption) {
    margin-top: 10px;
    padding-left: 14px;
    border-left: 2px solid var(--gold);
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .prose :global(#key-references + ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.97rem;
    line-height: 1.5;
  }
  .prose :global(#key-references + ul li) {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    overflow-wrap: anywhere;
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .projects li {
    display: flex;
    flex-direction: column;
    padding: 20px 22px 22px;
    background: var(--soft);
    border-top: 3px solid var(--blue);
  }
  .projects h3 {
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .projects h3 a {
    text-decoration: none;
  }
  .projects h3 a:hover {
    text-decoration: underline;
  }
  .projects p {
    font-size: 0.98rem;
    line-height: 1.45;
    margin-bottom: 14px;
  }
  .projects span {
    margin-top: auto;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pager {
    border-top: 1px solid var(--line);
    background: var(--soft);
  }
  .pager__in {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 30px;
    padding-bottom: 30px;
  }
  .pager a {
    font-family: var(--title);
    font-size: 1.25rem;
    color: var(--head);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--blue);
  }
  .pager a span {
    display: block;
    font-family: var(--font);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 4px;
  }
  .pager__next {
    text-align: right;
    margin-left: auto;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      order: 2;
      padding-top: 28px;
      border-top: 1px solid var(--line);
    }
    .side nav {
      display: none;
    }
    .side__people {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }
  }
  @media (max-width: 600px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
